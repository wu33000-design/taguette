#: taguette/database/__init__.py:151
#, python-format
msgid ""
"\n"
"    A backup copy of your database file has been created. If the update\n"
"    goes horribly wrong, make sure to keep that file, and let us know:\n"
"    %(backup)s\n"
msgstr ""
"\n"
"    已建立資料庫備份。若更新失敗，請保留此檔案並聯絡我們：\n"
"    %(backup)s\n"

#: taguette/main.py:448
#, python-format
msgid ""
"\n"
"    Taguette %(version)s is now running. You can connect to it using this "
"link:\n"
"\n"
"    %(url)s\n"
msgstr ""
"\n"
"    Taguette %(version)s 已啟動。請使用以下連結：\n"
"\n"
"    %(url)s\n"

#: taguette/database/__init__.py:163
msgid ""
"\n"
"    The database schema used by Taguette has changed! Because you are not "
"using\n"
"    SQLite, we will not attempt a migration automatically; back up your data"
" and run the migration command before restarting."
msgstr ""
"\n"
"    Taguette 的資料庫結構已變更。由於未使用 SQLite，無法自動遷移。請先備份資料並執行遷移指令，再重新啟動。"

#: taguette/database/__init__.py:140
msgid ""
"\n"
"    The database schema used by Taguette has changed! We will try to\n"
"    update your workspace automatically.\n"
msgstr ""
"\n"
"    Taguette 的資料庫結構已變更，將嘗試自動更新你的工作區。\n"

#: taguette/web/base.py:530
msgid ""
